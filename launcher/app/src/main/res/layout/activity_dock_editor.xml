<?xml version="1.0" encoding="utf-8"?>
<!-- Dock editor: pick any installed app for a dock slot. Same wallpaper and tile art as the home screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_bg">

    <ImageView
        android:id="@+id/editorWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/editor_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter_h"
        android:paddingEnd="@dimen/screen_gutter_h"
        android:paddingTop="40dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/editorTitle"
            style="@style/OnPhotoText"
            android:text="@string/dock_editor_title"
            android:textSize="34sp"
            android:fontFamily="@font/manrope_medium" />

        <TextView
            android:id="@+id/editorSubtitle"
            style="@style/OnPhotoText"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnResetDock"
                style="@style/TopButton"
                android:text="@string/dock_reset"
                android:drawableStart="@drawable/ic_home_settings" />

            <TextView
                android:id="@+id/btnAppInfo"
                style="@style/TopButton"
                android:layout_marginStart="8dp"
                android:text="@string/dock_app_info"
                android:drawableStart="@drawable/ic_settings" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/editorGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="40dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never" />
    </LinearLayout>
</FrameLayout>
