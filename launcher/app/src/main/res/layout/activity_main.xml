<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060608"
    android:keepScreenOn="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- SINGLE PERMANENT WALLPAPER LAYER (Loaded dynamically from TV storage) -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <!-- Subtle top & bottom cinematic vignette so text and glass dock stay 100% legible -->
    <View
        android:id="@+id/wallpaperScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/apple_tv_vignette"
        android:importantForAccessibility="no" />

    <!-- Ambient glow view for legacy theme engine -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="gone" />

    <!-- 2. HOME SCREEN: text sits straight on the photo (no cards); the dock floats at the bottom. -->
    <FrameLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Hidden legacy views kept so MainActivity's bindings still resolve -->
        <TextView android:id="@+id/heroName" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/shamsiDate" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/clockDivider" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/greeting" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/exploreHint" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        <!-- TOP AREA: clock + controls on the left, weather on the right. Fades away when the dock's
             second row opens, so the dock can use the full height. -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_gutter_h"
            android:paddingEnd="@dimen/screen_gutter_h"
            android:paddingTop="40dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/leftHeaderGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/section_gap"
                android:orientation="vertical"
                android:clipChildren="false">

                <LinearLayout
                    android:id="@+id/clockBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextClock
                            android:id="@+id/clock"
                            style="@style/OnPhotoText"
                            android:format12Hour="h:mm"
                            android:format24Hour="HH:mm"
                            android:textSize="92sp"
                            android:fontFamily="@font/manrope_medium"
                            android:letterSpacing="-0.035" />

                        <TextClock
                            android:id="@+id/ampm"
                            style="@style/OnPhotoText"
                            android:layout_marginStart="10dp"
                            android:layout_marginBottom="16dp"
                            android:format12Hour="a"
                            android:format24Hour=""
                            android:textColor="@color/text_secondary"
                            android:textSize="20sp"
                            android:fontFamily="@font/manrope_medium"
                            android:letterSpacing="0.06"
                            android:textAllCaps="true" />
                    </LinearLayout>

                    <TextClock
                        android:id="@+id/date"
                        style="@style/OnPhotoText"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="2dp"
                        android:format12Hour="EEEE, d MMMM"
                        android:format24Hour="EEEE, d MMMM"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.01" />
                </LinearLayout>

                <!-- Quick controls: separate frosted pills, no shared track -->
                <LinearLayout
                    android:id="@+id/topButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clipChildren="false">

                    <TextView
                        android:id="@+id/btnLiveTv"
                        style="@style/TopButton"
                        android:text="@string/tv_box"
                        android:drawableStart="@drawable/ic_livetv"
                        android:nextFocusLeft="@+id/btnLiveTv"
                        android:nextFocusRight="@+id/btnInputs"
                        android:nextFocusUp="@+id/btnLiveTv"
                        android:nextFocusDown="@+id/grid" />

                    <TextView
                        android:id="@+id/btnInputs"
                        style="@style/TopButton"
                        android:layout_marginStart="8dp"
                        android:text="@string/inputs"
                        android:drawableStart="@drawable/ic_input"
                        android:nextFocusLeft="@+id/btnLiveTv"
                        android:nextFocusRight="@+id/btnWifi"
                        android:nextFocusUp="@+id/btnInputs"
                        android:nextFocusDown="@+id/grid" />

                    <TextView
                        android:id="@+id/btnWifi"
                        style="@style/TopButton"
                        android:layout_marginStart="8dp"
                        android:text="@string/wifi"
                        android:drawableStart="@drawable/ic_wifi"
                        android:nextFocusLeft="@+id/btnInputs"
                        android:nextFocusRight="@+id/btnSettings"
                        android:nextFocusUp="@+id/btnWifi"
                        android:nextFocusDown="@+id/grid" />

                    <TextView
                        android:id="@+id/btnSettings"
                        style="@style/TopButton"
                        android:layout_marginStart="8dp"
                        android:text="@string/settings"
                        android:drawableStart="@drawable/ic_settings"
                        android:nextFocusLeft="@+id/btnWifi"
                        android:nextFocusRight="@+id/btnSettings"
                        android:nextFocusUp="@+id/btnSettings"
                        android:nextFocusDown="@+id/grid" />
                </LinearLayout>
            </LinearLayout>

            <!-- Weather widget, Apple medium-widget layout on the same smoked glass as the control pills:
                 location, now, the next six hours, a rain warning for the next 24 hours and details.
                 Display only: not focusable, not clickable. -->
            <LinearLayout
                android:id="@+id/weatherWidget"
                android:layout_width="344dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/weather_glass_bg"
                android:focusable="false"
                android:clickable="false"
                android:visibility="invisible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvWeatherLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableEnd="@drawable/ic_location_arrow"
                            android:drawablePadding="6dp"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600" />

                        <TextView
                            android:id="@+id/tvTodayTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:includeFontPadding="false"
                            android:textColor="@color/text_primary"
                            android:textSize="48sp"
                            android:fontFamily="@font/outfit_light" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <ImageView
                            android:id="@+id/ivTodayIcon"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tvTodayCondition"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:includeFontPadding="false"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600" />

                        <TextView
                            android:id="@+id/tvTodayHighLow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:includeFontPadding="false"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@color/divider_subtle" />

                <!-- Next six hours -->
                <LinearLayout
                    android:id="@+id/hourlyRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/tvRainChance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:drawableStart="@drawable/ic_umbrella"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600" />

                <TextView
                    android:id="@+id/tvWeatherDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500" />

                <TextView
                    android:id="@+id/tvAqi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- DOCK: anchored to the bottom. The container shows one row, or two when expanded (it
             grows upward while the top area fades); the grid always has room for both rows. -->
        <FrameLayout
            android:id="@+id/dockContainer"
            android:layout_width="match_parent"
            android:layout_height="149dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/screen_gutter_h"
            android:layout_marginEnd="@dimen/screen_gutter_h"
            android:layout_marginBottom="30dp"
            android:clipChildren="true"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="298dp"
                android:layout_gravity="top"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:overScrollMode="never" />
        </FrameLayout>

        <!-- SUBTLE CORNER SIGNATURE -->
        <TextView
            android:id="@+id/brandMark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/screen_gutter_h"
            android:layout_marginBottom="14dp"
            android:text="MADE BY VARDAN"
            android:textColor="@color/text_quiet"
            android:textSize="8.5sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400"
            android:letterSpacing="0.32"
            android:singleLine="true"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- 3. APPLE TV AMBIENT SCREENSAVER OVERLAY (Weather + Time + Date on Idle) -->
    <FrameLayout
        android:id="@+id/screensaverOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="gone"
        android:paddingStart="64dp"
        android:paddingEnd="64dp"
        android:paddingBottom="52dp"
        android:clipChildren="false">

        <LinearLayout
            android:id="@+id/screensaverHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:maxWidth="420dp"
            android:background="@drawable/weather_card_bg"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Wallpaper Title Eyebrow (Hidden: plain, simple & premium) -->
            <TextView
                android:id="@+id/ssWallpaperLabel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Apple TV Screensaver Time & Current Weather Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/ssClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_primary"
                    android:textSize="60sp"
                    android:fontFamily="@font/manrope_medium"
                    android:letterSpacing="-0.03" />

                <TextClock
                    android:id="@+id/ssAmPm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="8dp"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:includeFontPadding="false"
                    android:textColor="@color/accent_warm"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/divider_subtle" />

                <TextView
                    android:id="@+id/ssWeatherIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌙"
                    android:textSize="30sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ssWeatherTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="24°C"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 300" />

                    <TextView
                        android:id="@+id/ssWeatherDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text=""
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 400" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Row: Full Date + Forecast Summary -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/ssDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEEE, d MMMM yyyy"
                    android:format24Hour="EEEE, d MMMM yyyy"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="0.14"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/ssForecastSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="·   +3h 29°   ·   +6h 26°   ·   +12h 22°"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11.5sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 400" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
