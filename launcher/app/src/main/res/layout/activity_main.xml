<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060608"
    android:keepScreenOn="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- SINGLE PERMANENT WALLPAPER LAYER (Loaded dynamically from TV storage) -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <!-- Subtle top & bottom cinematic vignette so text and glass dock stay 100% legible -->
    <View
        android:id="@+id/wallpaperScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/apple_tv_vignette"
        android:importantForAccessibility="no" />

    <!-- Ambient glow view for legacy theme engine -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="gone" />

    <!-- 2. INTERACTIVE APPLE TV HOME SCREEN LAYER -->
    <FrameLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Hidden legacy views to preserve bindings in MainActivity without floating clutter -->
        <TextView
            android:id="@+id/heroName"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:textSize="0sp"
            android:textColor="@android:color/transparent"
            android:alpha="0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/shamsiDate"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:textSize="0sp"
            android:textColor="@android:color/transparent"
            android:alpha="0"
            android:visibility="gone" />

        <View
            android:id="@+id/clockDivider"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/greeting"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:textSize="0sp"
            android:textColor="@android:color/transparent"
            android:alpha="0"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:paddingTop="36dp"
            android:paddingBottom="34dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- ROW 1: MINIMALIST APPLE TV TOP BAR (Clock Left · Weather Right) -->
            <RelativeLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false">

                <!-- Left Column: Clock, AM/PM, Date, and Command Track directly underneath -->
                <LinearLayout
                    android:id="@+id/leftHeaderGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:orientation="vertical">

                    <!-- Typographic Clock & Date in Matching Glass Card -->
                    <LinearLayout
                        android:id="@+id/clockBlock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="360dp"
                        android:background="@drawable/glass_capsule_bg"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="18dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="bottom"
                            android:baselineAligned="true"
                            android:orientation="horizontal">

                            <TextClock
                                android:id="@+id/clock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:format12Hour="h:mm"
                                android:format24Hour="HH:mm"
                                android:includeFontPadding="false"
                                android:textColor="#FFFFFF"
                                android:textSize="80sp"
                                android:fontFamily="@font/manrope_medium"
                                android:letterSpacing="-0.03" />

                            <TextClock
                                android:id="@+id/ampm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_marginBottom="14dp"
                                android:format12Hour="a"
                                android:format24Hour=""
                                android:includeFontPadding="false"
                                android:textColor="#E2C799"
                                android:textSize="18sp"
                                android:fontFamily="@font/manrope_medium"
                                android:letterSpacing="0.08"
                                android:textAllCaps="true" />
                        </LinearLayout>

                        <TextClock
                            android:id="@+id/date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:includeFontPadding="false"
                            android:format12Hour="EEEE · d MMMM yyyy"
                            android:format24Hour="EEEE · d MMMM yyyy"
                            android:textColor="#CBD5E1"
                            android:textSize="13sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:letterSpacing="0.14"
                            android:textAllCaps="true" />
                    </LinearLayout>

                    <!-- Quick Controls anchored directly below clock -->
                    <LinearLayout
                        android:id="@+id/topButtons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/command_track_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="4dp"
                        android:clipChildren="false">

                        <TextView
                            android:id="@+id/btnLiveTv"
                            style="@style/TopButton"
                            android:text="Live TV"
                            android:drawableStart="@drawable/ic_livetv"
                            android:nextFocusLeft="@+id/btnSettings"
                            android:nextFocusRight="@+id/btnInputs"
                            android:nextFocusUp="@+id/btnLiveTv"
                            android:nextFocusDown="@+id/grid" />

                        <TextView
                            android:id="@+id/btnInputs"
                            style="@style/TopButton"
                            android:layout_marginStart="4dp"
                            android:text="@string/inputs"
                            android:drawableStart="@drawable/ic_input"
                            android:nextFocusLeft="@+id/btnLiveTv"
                            android:nextFocusRight="@+id/btnWifi"
                            android:nextFocusUp="@+id/btnInputs"
                            android:nextFocusDown="@+id/grid" />

                        <TextView
                            android:id="@+id/btnWifi"
                            style="@style/TopButton"
                            android:layout_marginStart="4dp"
                            android:text="@string/wifi"
                            android:drawableStart="@drawable/ic_wifi"
                            android:nextFocusLeft="@+id/btnInputs"
                            android:nextFocusRight="@+id/btnSettings"
                            android:nextFocusUp="@+id/btnWifi"
                            android:nextFocusDown="@+id/grid" />

                        <TextView
                            android:id="@+id/btnSettings"
                            style="@style/TopButton"
                            android:layout_marginStart="4dp"
                            android:text="@string/settings"
                            android:drawableStart="@drawable/ic_settings"
                            android:nextFocusLeft="@+id/btnWifi"
                            android:nextFocusRight="@+id/weatherWidget"
                            android:nextFocusUp="@+id/weatherWidget"
                            android:nextFocusDown="@+id/grid" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Right Column: Apple-Widget-Style Weather Card -->
                <LinearLayout
                    android:id="@+id/weatherWidget"
                    android:layout_width="420dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="24dp"
                    android:orientation="vertical"
                    android:background="@drawable/glass_capsule_bg"
                    android:padding="20dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@+id/btnSettings"
                    android:nextFocusDown="@+id/grid">

                    <!-- Today's summary row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivTodayIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvTodayTemp"
                                android:fontFamily="@font/outfit_light"
                                android:textSize="34sp"
                                android:textColor="@color/text_primary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/tvTodayCondition"
                                android:textSize="14sp"
                                android:textColor="@color/text_secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <!-- Rain chance, shown only if meaningfully likely -->
                        <TextView
                            android:id="@+id/tvRainChance"
                            android:textSize="14sp"
                            android:textColor="@color/accent_blue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_subtle"
                        android:layout_marginVertical="12dp" />

                    <!-- 4-day forecast strip -->
                    <LinearLayout
                        android:id="@+id/dailyForecastRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4" />
                </LinearLayout>
            </RelativeLayout>

            <!-- ROW 3: OPEN NATURE WALLPAPER SHOWCASE SPACE -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- ROW 4: APPLE TV FLOATING GLASS DOCK (4 Main Apps + 4 Secondary on Down) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="148dp"
                android:clipChildren="true"
                android:clipToPadding="false">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:overScrollMode="never" />
            </FrameLayout>

            <!-- ROW 5: MINIMAL DRAWER HINT (HIDDEN FOR ZERO CLUTTER) -->
            <TextView
                android:id="@+id/exploreHint"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>


        <!-- SUBTLE CORNER SIGNATURE -->
        <TextView
            android:id="@+id/brandMark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="80dp"
            android:layout_marginBottom="24dp"
            android:text="MADE BY VARDAN"
            android:textColor="#29F5F2EB"
            android:textSize="8.5sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400"
            android:letterSpacing="0.32"
            android:singleLine="true"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- 3. APPLE TV AMBIENT SCREENSAVER OVERLAY (Weather + Time + Date on Idle) -->
    <FrameLayout
        android:id="@+id/screensaverOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="gone"
        android:paddingStart="64dp"
        android:paddingEnd="64dp"
        android:paddingBottom="52dp"
        android:clipChildren="false">

        <LinearLayout
            android:id="@+id/screensaverHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:maxWidth="420dp"
            android:background="@drawable/weather_card_bg"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Wallpaper Title Eyebrow (Hidden: plain, simple & premium) -->
            <TextView
                android:id="@+id/ssWallpaperLabel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Apple TV Screensaver Time & Current Weather Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/ssClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFF"
                    android:textSize="60sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 400"
                    android:letterSpacing="-0.03" />

                <TextClock
                    android:id="@+id/ssAmPm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="8dp"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:includeFontPadding="false"
                    android:textColor="#E2C799"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="#24FFFFFF" />

                <TextView
                    android:id="@+id/ssWeatherIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌙"
                    android:textSize="30sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ssWeatherTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="24°C"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 300" />

                    <TextView
                        android:id="@+id/ssWeatherDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Chanakyapuri · Clear"
                        android:textColor="#CBD5E1"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 400" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Row: Full Date + Forecast Summary -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/ssDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEEE, d MMMM yyyy"
                    android:format24Hour="EEEE, d MMMM yyyy"
                    android:textColor="#CBD5E1"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="0.14"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/ssForecastSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="·   +3h 29°   ·   +6h 26°   ·   +12h 22°"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 400" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
