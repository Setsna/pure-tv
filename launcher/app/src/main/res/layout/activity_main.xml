<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060608"
    android:keepScreenOn="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- SINGLE PERMANENT WALLPAPER LAYER (Loaded dynamically from TV storage) -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <!-- Subtle top & bottom cinematic vignette so text and glass dock stay 100% legible -->
    <View
        android:id="@+id/wallpaperScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/apple_tv_vignette"
        android:importantForAccessibility="no" />

    <!-- Ambient glow view for legacy theme engine -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="gone" />

    <!-- 2. HOME SCREEN: text sits straight on the photo (no cards); the dock floats at the bottom. -->
    <FrameLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Hidden legacy views kept so MainActivity's bindings still resolve -->
        <TextView android:id="@+id/heroName" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/shamsiDate" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <View android:id="@+id/clockDivider" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/greeting" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/exploreHint" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        <!-- TOP AREA, three symmetric bands: time | weather now, controls | rain, then one full-width
             glass strip (next hours | stats). Fades away when the dock's second row opens. -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_gutter_h"
            android:paddingEnd="@dimen/screen_gutter_h"
            android:paddingTop="30dp"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Band 1: clock on the left, its mirror on the right: weather icon + temperature, same face
                 and size as the clock, with a subtitle line matching the date. -->
            <LinearLayout
                android:id="@+id/leftHeaderGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/clockBlock"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextClock
                            android:id="@+id/clock"
                            style="@style/OnPhotoText"
                            android:format12Hour="h:mm"
                            android:format24Hour="HH:mm"
                            android:textSize="84sp"
                            android:fontFamily="@font/manrope_medium"
                            android:letterSpacing="-0.035" />

                        <TextClock
                            android:id="@+id/ampm"
                            style="@style/OnPhotoText"
                            android:layout_marginStart="10dp"
                            android:layout_marginBottom="16dp"
                            android:format12Hour="a"
                            android:format24Hour=""
                            android:textColor="@color/text_secondary"
                            android:textSize="20sp"
                            android:fontFamily="@font/manrope_medium"
                            android:letterSpacing="0.06"
                            android:textAllCaps="true" />
                    </LinearLayout>

                    <TextClock
                        android:id="@+id/date"
                        style="@style/OnPhotoText"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="2dp"
                        android:format12Hour="EEEE, d MMMM"
                        android:format24Hour="EEEE, d MMMM"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp"
                        android:fontFamily="@font/outfit_medium"
                        android:letterSpacing="0.01" />
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/weatherNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:visibility="invisible">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivTodayIcon"
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:layout_marginEnd="14dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tvTodayTemp"
                            style="@style/OnPhotoText"
                            android:textSize="84sp"
                            android:fontFamily="@font/manrope_medium"
                            android:letterSpacing="-0.035" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTodayCondition"
                        style="@style/OnPhotoText"
                        android:layout_marginTop="2dp"
                        android:drawablePadding="8dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp"
                        android:fontFamily="@font/outfit_medium"
                        android:letterSpacing="0.01" />

                    <TextView
                        android:id="@+id/tvWeatherUpdated"
                        style="@style/OnPhotoText"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/outfit_medium"
                        android:letterSpacing="0.02" />
                </LinearLayout>
            </LinearLayout>

            <!-- Band 2: the four control pills on the left, the rain pill mirroring them on the right. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false">

                <LinearLayout
                    android:id="@+id/topButtons"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clipChildren="false">

                    <TextView
                        android:id="@+id/btnLiveTv"
                        style="@style/TopButton"
                        android:text="@string/tv_box"
                        android:drawableStart="@drawable/ic_livetv"
                        android:nextFocusLeft="@+id/btnLiveTv"
                        android:nextFocusRight="@+id/btnInputs"
                        android:nextFocusUp="@+id/btnLiveTv"
                        android:nextFocusDown="@+id/grid" />

                    <TextView
                        android:id="@+id/btnInputs"
                        style="@style/TopButton"
                        android:layout_marginStart="8dp"
                        android:text="@string/inputs"
                        android:drawableStart="@drawable/ic_input"
                        android:nextFocusLeft="@+id/btnLiveTv"
                        android:nextFocusRight="@+id/btnWifi"
                        android:nextFocusUp="@+id/btnInputs"
                        android:nextFocusDown="@+id/grid" />

                    <TextView
                        android:id="@+id/btnWifi"
                        style="@style/TopButton"
                        android:layout_marginStart="8dp"
                        android:text="@string/wifi"
                        android:drawableStart="@drawable/ic_wifi"
                        android:nextFocusLeft="@+id/btnInputs"
                        android:nextFocusRight="@+id/btnSettings"
                        android:nextFocusUp="@+id/btnWifi"
                        android:nextFocusDown="@+id/grid" />

                    <TextView
                        android:id="@+id/btnSettings"
                        style="@style/TopButton"
                        android:layout_marginStart="8dp"
                        android:text="@string/settings"
                        android:drawableStart="@drawable/ic_settings"
                        android:nextFocusLeft="@+id/btnWifi"
                        android:nextFocusRight="@+id/btnSettings"
                        android:nextFocusUp="@+id/btnSettings"
                        android:nextFocusDown="@+id/grid" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRainChance"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/weather_glass_pill"
                    android:drawableStart="@drawable/ic_umbrella"
                    android:drawablePadding="8dp"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/outfit_medium"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- Band 3: one long, low glass strip, gutter to gutter: the next six hours, then four stats
                 (icon + label, value, detail). Display only: not focusable. -->
            <LinearLayout
                android:id="@+id/weatherWidget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/weather_glass_bg"
                android:baselineAligned="false"
                android:focusable="false"
                android:visibility="invisible">

                <LinearLayout
                    android:id="@+id/hourlyRow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:background="@color/divider_subtle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="16dp">

                        <TextView
                            style="@style/WeatherStatLabel"
                            android:drawableStart="@drawable/ic_thermometer"
                            android:text="@string/stat_feels" />

                        <TextView
                            android:id="@+id/tvFeels"
                            style="@style/WeatherStatValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="16dp">

                        <TextView
                            style="@style/WeatherStatLabel"
                            android:drawableStart="@drawable/ic_humidity"
                            android:text="@string/stat_humidity" />

                        <TextView
                            android:id="@+id/tvHumidity"
                            style="@style/WeatherStatValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="16dp">

                        <TextView
                            style="@style/WeatherStatLabel"
                            android:drawableStart="@drawable/ic_wind"
                            android:text="@string/stat_wind" />

                        <TextView
                            android:id="@+id/tvWind"
                            style="@style/WeatherStatValue" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="16dp">

                        <TextView
                            style="@style/WeatherStatLabel"
                            android:drawableStart="@drawable/ic_air"
                            android:text="@string/stat_air" />

                        <TextView
                            android:id="@+id/tvAqiValue"
                            style="@style/WeatherStatValue" />
                        <TextView
                            android:id="@+id/tvAqiLabel"
                            style="@style/WeatherStatSub" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- DOCK: anchored to the bottom. The container shows one row, or two when expanded (it
             grows upward while the top area fades); the grid always has room for both rows. -->
        <FrameLayout
            android:id="@+id/dockContainer"
            android:layout_width="match_parent"
            android:layout_height="149dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/screen_gutter_h"
            android:layout_marginEnd="@dimen/screen_gutter_h"
            android:layout_marginBottom="24dp"
            android:clipChildren="true"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="298dp"
                android:layout_gravity="top"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:overScrollMode="never" />
        </FrameLayout>

        <!-- SUBTLE CORNER SIGNATURE -->
        <TextView
            android:id="@+id/brandMark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/screen_gutter_h"
            android:layout_marginBottom="14dp"
            android:text="MADE BY VARDAN"
            android:textColor="@color/text_quiet"
            android:textSize="8.5sp"
            android:fontFamily="@font/outfit_regular"
            android:letterSpacing="0.32"
            android:singleLine="true"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- 3. SCREENSAVER: glass dashboard over the photo. Clock, date and a quote of the day on the
         left; weather, next hours and stats in glass cards on the right. Shows the
         last forecast Home fetched; fetches nothing itself. ScreensaverDashboard fills it. -->
    <FrameLayout
        android:id="@+id/screensaverOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="gone"
        android:background="@color/screensaver_scrim"
        android:clipChildren="false">

        <LinearLayout
            android:id="@+id/screensaverHud"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingStart="72dp"
            android:paddingEnd="64dp"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <!-- Left: time and the day -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="40dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextClock
                        android:id="@+id/ssClock"
                        style="@style/OnPhotoText"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textSize="128sp"
                        android:fontFamily="@font/manrope_medium"
                        android:letterSpacing="-0.04" />

                    <TextClock
                        android:id="@+id/ssAmPm"
                        style="@style/OnPhotoText"
                        android:layout_marginStart="12dp"
                        android:layout_marginBottom="24dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="@color/text_secondary"
                        android:textSize="26sp"
                        android:fontFamily="@font/manrope_medium"
                        android:textAllCaps="true" />
                </LinearLayout>

                <TextClock
                    android:id="@+id/ssDate"
                    style="@style/OnPhotoText"
                    android:layout_marginStart="6dp"
                    android:format12Hour="EEEE, d MMMM"
                    android:format24Hour="EEEE, d MMMM"
                    android:textColor="@color/text_secondary"
                    android:textSize="26sp"
                    android:fontFamily="@font/outfit_medium" />

                <View
                    android:layout_width="56dp"
                    android:layout_height="2dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="34dp"
                    android:background="@color/frost_edge" />

                <TextView
                    android:id="@+id/ssQuote"
                    style="@style/OnPhotoText"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="22dp"
                    android:maxWidth="560dp"
                    android:lineSpacingExtra="4dp"
                    android:textSize="22sp"
                    android:fontFamily="@font/outfit_light" />

                <TextView
                    android:id="@+id/ssQuoteBy"
                    style="@style/OnPhotoText"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp"
                    android:letterSpacing="0.14"
                    android:textAllCaps="true"
                    android:fontFamily="@font/outfit_semibold" />
            </LinearLayout>

            <!-- Right: a column of glass cards -->
            <LinearLayout
                android:id="@+id/ssWeather"
                android:layout_width="380dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:visibility="invisible">

                <!-- Now -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:background="@drawable/weather_glass_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ssWeatherIcon"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/ssWeatherTemp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:includeFontPadding="false"
                            android:textColor="@color/text_primary"
                            android:textSize="46sp"
                            android:fontFamily="@font/manrope_medium" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:id="@+id/ssWeatherDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:textColor="@color/text_primary"
                                android:textSize="17sp"
                                android:fontFamily="@font/outfit_semibold" />

                            <TextView
                                android:id="@+id/ssHighLow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:includeFontPadding="false"
                                android:textColor="@color/text_secondary"
                                android:textSize="15sp"
                                android:fontFamily="@font/outfit_medium" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ssLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:drawableStart="@drawable/ic_location_arrow"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/text_secondary"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit_medium" />

                    <TextView
                        android:id="@+id/ssRain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawableStart="@drawable/ic_umbrella"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit_medium" />

                    <TextView
                        android:id="@+id/ssUpdated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/outfit_medium" />
                </LinearLayout>

                <!-- Next hours -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/weather_glass_bg">

                    <TextView
                        style="@style/WeatherStatLabel"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/ss_next_hours" />

                    <LinearLayout
                        android:id="@+id/ssHourly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </LinearLayout>

                <!-- Stats, 2 x 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:background="@drawable/weather_glass_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/WeatherStatLabel" android:drawableStart="@drawable/ic_thermometer" android:text="@string/stat_feels" />
                        <TextView android:id="@+id/ssFeels" style="@style/WeatherStatValue" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/WeatherStatLabel" android:drawableStart="@drawable/ic_humidity" android:text="@string/stat_humidity" />
                        <TextView android:id="@+id/ssHumidity" style="@style/WeatherStatValue" />
                    </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/WeatherStatLabel" android:drawableStart="@drawable/ic_wind" android:text="@string/stat_wind" />
                        <TextView android:id="@+id/ssWind" style="@style/WeatherStatValue" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/WeatherStatLabel" android:drawableStart="@drawable/ic_air" android:text="@string/stat_air" />
                        <TextView android:id="@+id/ssAqi" style="@style/WeatherStatValue" />
                        <TextView android:id="@+id/ssAqiLabel" style="@style/WeatherStatSub" />
                    </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
