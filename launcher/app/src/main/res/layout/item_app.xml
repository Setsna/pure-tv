<?xml version="1.0" encoding="utf-8"?>
<!-- One dock tile: full-bleed artwork (the app's TV banner, or TileArt for apps without a good one)
     under a soft light sheen; the app's name fades in below the tile when it has focus. The item is
     exactly as tall as the tile (set in AppAdapter); the name draws into the row's bottom padding. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="101dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="180dp"
        android:layout_height="101dp"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/tile_bg"
        android:focusable="true"
        android:clickable="true">

        <ImageView
            android:id="@+id/art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <View
            android:id="@+id/sheen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/tile_sheen"
            android:alpha="0.35" />
    </FrameLayout>

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:gravity="center"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="111dp"
        android:alpha="0"
        android:singleLine="true"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:shadowColor="@color/photo_text_shadow"
        android:shadowRadius="12"
        android:shadowDy="2" />
</FrameLayout>
