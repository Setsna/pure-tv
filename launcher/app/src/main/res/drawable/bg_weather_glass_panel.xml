<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Translucent Liquid Glass Fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/weather_glass_tint" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
    <!-- Top-Edge Specular Glass Light Spill -->
    <item android:top="0dp" android:height="2dp" android:left="24dp" android:right="24dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="@color/weather_glass_edge"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- 1dp Precision Glass Perimeter Stroke -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/weather_glass_edge" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
</layer-list>
