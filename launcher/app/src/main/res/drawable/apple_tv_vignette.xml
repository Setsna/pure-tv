<?xml version="1.0" encoding="utf-8"?>
<!-- Photo scrim: darker at the top (clock, weather) and bottom (dock), clear through the middle so
     the photograph carries the screen. Replaces glass cards behind the text. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26000000" />
        </shape>
    </item>
    <item android:gravity="top" android:height="420dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#A6000000" android:centerColor="#40000000" android:endColor="#00000000" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="300dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#B3000000" android:centerColor="#4D000000" android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
