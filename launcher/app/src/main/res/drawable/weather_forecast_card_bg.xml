<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: Vibrant Thin Glass with Champagne Gold Edge -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/weather_glass_tint_strong" />
            <stroke android:width="1.5dp" android:color="@color/champagne_gold" />
            <corners android:radius="@dimen/radius_tile" />
        </shape>
    </item>
    <!-- Resting / Normal: Subtle Translucent Glass -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/weather_glass_tint" />
            <stroke android:width="1dp" android:color="@color/weather_glass_edge" />
            <corners android:radius="@dimen/radius_tile" />
        </shape>
    </item>
</selector>
