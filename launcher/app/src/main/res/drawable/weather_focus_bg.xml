<?xml version="1.0" encoding="utf-8"?>
<!-- Weather has no card at rest; on focus a frosted plate with a white edge marks it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/frost_fill" />
            <corners android:radius="@dimen/radius_card" />
            <stroke android:width="2dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
</selector>
