<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/tile_surface_top" android:endColor="@color/tile_surface_bottom" />
            <corners android:radius="@dimen/radius_tile" />
            <stroke android:width="2dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item android:drawable="@drawable/dock_tile_bg" />
</selector>
